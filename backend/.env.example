# Copy this file to `.env` and fill in what you need.
# The app runs with ZERO keys set (LLM_PROVIDER=none) — the RAG assistant
# will still retrieve and show relevant knowledge-base info, just without
# free-form AI generation. Set one provider below to unlock full LLM answers.

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./data/medverse.db

# --- LLM provider: openai | anthropic | ollama | none ---
LLM_PROVIDER=none

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (local, free, no API key — https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings model (downloaded automatically on first run) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- CORS (comma separated). Not needed if using the Vite/nginx /api proxy. ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3004
